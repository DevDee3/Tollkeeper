# Copy to .env, or let `npm run make-agent-key` create .env for you.
POLICY_ACCOUNT=tollkeeper-policy.testnet
AGENT_ACCOUNT=tollkeeper-agent.testnet
AGENT_KEY=ed25519:your-restricted-key
# Optional
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# VENDOR_DATA=tollkeeper-data.testnet
# VENDOR_SUMMARIZER=tollkeeper-writer.testnet
# VENDOR_PREMIUM=tollkeeper-premium.testnet

# Only for the model-driven agent (npm run demo:llm / npm run demo:live:llm)
# ANTHROPIC_API_KEY=your-key
# LLM_MODEL=claude-haiku-5-5
